# Optional — the app works fine with localStorage only if these are left blank.
# Set these to sync balances across every device (see README for setup steps).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Leave blank unless you're pointing multiple households at one
# Supabase project and need to keep their data separate.
VITE_HOUSEHOLD_ID=
